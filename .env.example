# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it's already in .gitignore).

# Required for real LLM calls (Task 1 triage, Task 2 briefs, LLM-as-judge in Task 3).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Optional overrides -- defaults shown.
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0
MAX_TOKENS_TRIAGE=1200
MAX_TOKENS_BRIEF=1500

# Set to 1 to bypass the LLM API entirely and use the deterministic
# rule-based mock backend (src/mock_llm.py). Used by CI and for offline
# smoke-testing without a key -- never set this to 1 for a real demo.
USE_MOCK_LLM=0
